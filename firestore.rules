rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. User Profiles: strictly private to the user themselves
    match /user_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. User Watchlists: strictly private to the user
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Citizen Impact Reports (Public document)
    match /reports/{reportId} {
      // Public can only read approved reports; authors can see their own reports
      allow read: if resource.data.status == "approved" ||
                     (request.auth != null && resource.data.user_id == request.auth.uid);
      
      // Anyone can submit a pending report (status MUST be "pending")
      // Crucial: reporter_contact and private_note MUST NOT be in this document!
      allow create: if request.resource.data.status == "pending" &&
                       !('reporter_contact' in request.resource.data) &&
                       !('private_note' in request.resource.data);
      
      // Authors can update description or incident_date while pending,
      // but CANNOT change status or self-approve!
      allow update: if request.auth != null &&
                       resource.data.user_id == request.auth.uid &&
                       resource.data.status == "pending" &&
                       request.resource.data.status == "pending" &&
                       !('reporter_contact' in request.resource.data) &&
                       !('private_note' in request.resource.data);
                       
      // Authors can only delete unapproved reports
      allow delete: if request.auth != null &&
                       resource.data.user_id == request.auth.uid &&
                       resource.data.status != "approved";

      // 3.1 Sensitive details subcollection (reporter_contact, private_note)
      // Completely isolated from the public document.
      match /sensitive/details {
        // Can only be read by the author who submitted it (or backend admin SDK)
        allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
        // Creation allowed on report submission
        allow create: if true;
        // Updates only by author while report is pending
        allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      }
    }

    // 4. Location Corrections (Tier 4 crowdsourcing)
    match /location_corrections/{correctionId} {
      // Anyone can submit a correction (status must be "pending")
      allow create: if request.resource.data.status == "pending";
      // Author only can view their submission (admin uses server SDK)
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      // Author only can edit or cancel while still pending
      allow update: if request.auth != null &&
                       resource.data.user_id == request.auth.uid &&
                       resource.data.status == "pending" &&
                       request.resource.data.status == "pending";
      allow delete: if request.auth != null &&
                       resource.data.user_id == request.auth.uid &&
                       resource.data.status == "pending";
    }
  }
}
