PORT=3001
DATABASE_URL=postgres://user:password@host:port/database_name

# Static bearer token for the /api/admin/* moderation endpoints.
# Generate with: openssl rand -hex 32
# Must also be set in the Vercel project env for the deployed function.
ADMIN_TOKEN=

# Optional: Longdo Map API key for server/sync/geocode_missing.py (Tier 2)
# Get one at https://map.longdo.com/console
LONGDO_API_KEY=
