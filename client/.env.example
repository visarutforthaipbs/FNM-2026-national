# This app talks to TWO databases. See supabase/README.md for why.

# ── Government data (lighthouse-sev01, self-hosted Supabase) ────────────────
# Factories, businesses, permits, DBD ownership. Rebuildable from the
# collectors. Served over the Tailscale Funnel, which exposes /rest/v1 only.
VITE_SUPABASE_URL=https://lighthouse-sev01.tail83945e.ts.net
VITE_SUPABASE_ANON_KEY=your-sev01-anon-key

# ── Citizen data & Auth (Firebase) ──────────────────────────────────────────
# Accounts, watchlists, reports, photo evidence. Never auto-pauses.
# Get credentials from Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── Admin moderation API ───────────────────────────────────────────────────
# Runs on sev01, tailnet-only (port 4443, deliberately not funnelled).
# Reviewers need Tailscale connected. See HANDOFF.md §8-9.
VITE_API_BASE=https://lighthouse-sev01.tail83945e.ts.net:4443

# ── Optional Basemap API Key ──────────────────────────────────────────────
# Default basemaps use Esri Canvas & OpenStreetMap (no key required).
# If you prefer CARTO Positron/Dark Matter, provide a key from https://carto.com/basemaps/apikey
# VITE_CARTO_API_KEY=your-carto-key
# GISTDA Sphere Map API Key (https://sphere.gistda.or.th)
VITE_SPHERE_API_KEY=your-sphere-api-key


