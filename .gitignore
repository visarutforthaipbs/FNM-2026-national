# Root .gitignore
node_modules/
dist/
.env
.DS_Store

# Client-specific
client/node_modules/
client/dist/
client/.env*

# Server-specific
server/node_modules/
server/.env
server/sync/venv/
server/sync/__pycache__/
server/collector/operators.tsv
__pycache__/
*.pyc

# Large data exports (exceed GitHub 100MB limit)
all_factories_export.csv
active_factories_for_dbd_match.csv
missing_coordinates.csv
enriched_factories_sample.csv
.vercel

# Local geodatabases — rebuildable from their harvesters, and far over
# GitHub's 100 MB limit (dpt_geodatabase.db alone is ~400 MB).
server/data/*.db

# Factory→land-title-deed mappings. These stay out of the repo, and above all
# out of client/public/, which is served to everyone: 551 of the 8,705 records
# name a private individual and tie them to a specific land parcel. The admin
# tool that needs them should read them through an authenticated route.
server/data/landsmaps_resolved.json
client/public/data/landsmaps_resolved.json

# Browser session cookies used to pass WAFs. Credentials for as long as they
# last — never in the repo.
*cookies*.json
*session*.json
